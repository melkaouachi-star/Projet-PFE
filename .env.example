# ============================================================
# Environment variables - copy to .env and adapt
# ============================================================

ENV=development
LOG_LEVEL=INFO

# Database
DATABASE_URL=sqlite:///./fraud_detection.db
# DATABASE_URL=postgresql+psycopg2://fraud_user:secret@localhost:5432/fraud_db

# API
API_HOST=0.0.0.0
API_PORT=8000
API_SECRET_KEY=change-me-in-production

# Dashboard
DASHBOARD_API_BASE_URL=http://localhost:8000

# MLflow (optional)
MLFLOW_TRACKING_URI=./mlruns
