# ============================================================
# Streamlit dashboard image
# ============================================================
FROM python:3.11-slim

WORKDIR /app

COPY requirements.txt .

RUN pip install -r requirements.txt

COPY src ./src
COPY configs ./configs

ENV PYTHONPATH=/app

EXPOSE 8501

CMD ["streamlit", "run", "src/dashboard/app.py", "--server.port=8501", "--server.address=0.0.0.0"]